{
  "name": "live-component-editor-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root for the Live Component Editor monorepo",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "install": "npm install --workspaces --if-present"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.3",
    "@radix-ui/react-slot": "^1.2.3",
    "lucide-react": "^0.542.0"
  }
}
