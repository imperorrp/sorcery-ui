# Copy this file to `.env` and fill in the values for local development.
# Required variables are used by the server for AI integration and DB connectivity.
PORT=3000

# Required for the AI service (Gemini / Google GenAI)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# Optional: For future OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here
# MongoDB connection string (use a hosted URI or local Mongo)
# Examples:
#   Local (default if not set): mongodb://localhost:27017
#   Atlas: mongodb+srv://<user>:<pass>@cluster0.mongodb.net
MONGO_URI=mongodb://localhost:27017
# Optional: specify DB name separately
#MONGO_DB_NAME=sorcery-ui
